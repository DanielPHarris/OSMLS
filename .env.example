# Copy to .env for local development. These are development-only values.
DATABASE_URL=postgres://osmls:osmls@localhost:5433/osmls
# A separate database for automated tests, created by `pnpm test:db`.
TEST_DATABASE_URL=postgres://osmls:osmls@localhost:5433/osmls_test
BETTER_AUTH_SECRET=dev-only-secret-change-me-before-any-real-use
BETTER_AUTH_URL=http://localhost:3000
# Where uploaded photos are stored.
MEDIA_DIR=./data/media
# Password given to every synthetic demo account by `pnpm db:seed`.
DEMO_PASSWORD=osmls-demo-password
# Map source: any MapLibre-compatible style URL. Leave unset for the demo default
# (OpenFreeMap's public service, which has no availability guarantee).
# MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
