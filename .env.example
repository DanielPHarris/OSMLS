# Copy to .env for local development. These are development-only values.
DATABASE_URL=postgres://osmls:osmls@localhost:5433/osmls
# A separate database for automated tests, created by `pnpm test:db`.
TEST_DATABASE_URL=postgres://osmls:osmls@localhost:5433/osmls_test
BETTER_AUTH_SECRET=dev-only-secret-change-me-before-any-real-use
BETTER_AUTH_URL=http://localhost:3000
# Where uploaded photos are stored.
MEDIA_DIR=./data/media
# Password given to every synthetic demo account by `pnpm db:seed`.
DEMO_PASSWORD=osmls-demo-password
# Map source: any MapLibre-compatible style URL. Leave unset for the demo default
# (OpenFreeMap's public service, which has no availability guarantee).
# MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Outgoing email. Leave SMTP_URL unset to turn email off. These values point at
# the mail catcher that `docker compose up -d mail` starts; it delivers nothing.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="OSMLS demo <no-reply@osmls.example>"
# The mail catcher's own address, used only by the automated tests to read mail.
MAILPIT_URL=http://localhost:8025

# Backups (pnpm backup, pnpm restore). Where backups are written, and how many
# complete ones are kept.
BACKUP_DIR=./data/backups
BACKUP_KEEP=14

# Monitoring. Where the scheduled command (pnpm alerts:send) emails what is wrong
# with the installation. Leave unset to email nothing; it is still recorded and
# shown on the Operations screen.
# OPS_EMAIL=operations@example.com
# How long without a successful backup, or without a completed scheduled run,
# before one is overdue.
# BACKUP_OVERDUE_HOURS=26
# SCHEDULED_OVERDUE_HOURS=2
